# Copy to .env and fill in your own local values. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<session-pooler-host>:5432/postgres?sslmode=require
